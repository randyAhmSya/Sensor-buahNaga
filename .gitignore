node_modules/
**/node_modules/
dist/
build/
*.log
.env
.env.local
.env.*.local
.DS_Store
Thumbs.db

# ============================
# apps/api — Node.js/Express/Prisma
# ============================
apps/api/node_modules/
apps/api/dist/
apps/api/.env
apps/api/prisma/*.db
apps/api/prisma/migrations/dev/

# ============================
